# ─── LANDED ────────────────────────────────────────────────────────────────
# Local zero-config database (SQLite). For production, point this at Postgres
# and change the datasource provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Public app URL (used for links and metadata)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Tatum Sui (server only) ───────────────────────────────────────────────
# Create a free key at https://dashboard.tatum.io. Never expose this to the browser.
TATUM_API_KEY=""
TATUM_SUI_RPC_URL="https://sui-mainnet.gateway.tatum.io"
TATUM_SUI_NETWORK="mainnet"

# ─── Walrus Memory (server only) ───────────────────────────────────────────
# Create at https://memory.walrus.xyz. Use a DELEGATE key, never the owner key.
MEMWAL_PRIVATE_KEY=""
MEMWAL_ACCOUNT_ID=""
MEMWAL_SERVER_URL="https://relayer.memory.walrus.xyz"
# Optional: an existing delegate key is scoped to one account. LANDED derives
# a per-user namespace server-side from the authenticated user id.
MEMWAL_APP_PREFIX="landed"

# ─── Optional AI explanation layer ─────────────────────────────────────────
# OpenAI-compatible chat completions endpoint. LANDED's arithmetic and
# decisions never depend on this. Without it, deterministic explanations are used.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""

# ─── Demo ──────────────────────────────────────────────────────────────────
# Demo route is enabled by default. Set to "false" to disable /api/auth/demo.
LANDED_DEMO_ENABLED="true"
