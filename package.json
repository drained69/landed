{
  "name": "landed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx --env-file-if-exists=.env prisma/seed.ts",
    "setup": "prisma generate && prisma db push && tsx --env-file-if-exists=.env prisma/seed.ts",
    "walrus:verify": "tsx --env-file-if-exists=.env scripts/walrus-verify.ts",
    "walrus:backfill": "tsx --env-file-if-exists=.env scripts/walrus-backfill.ts",
    "demo:snapshot": "tsx --env-file-if-exists=.env scripts/demo-snapshot.ts"
  },
  "dependencies": {
    "@mysten-incubation/memwal": "^0.1.10",
    "@prisma/client": "^6.19.0",
    "@tanstack/react-query": "^5.105.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@9.0.0"
}
